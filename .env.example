# =============================================================================
# Tenant-scoped configuration.
# This file is generated automatically by setup-tenant.sh — do not edit by
# hand for a real tenant. Keep this .example file as the schema reference.
# =============================================================================

# --- Tenant identity ---------------------------------------------------------
TENANT_ID=0
TENANT_NAME=example
BASE_DOMAIN=unkredible.com

# --- Tenant database (one logical DB per tenant on the shared Postgres) ------
TENANT_DB_NAME=db_tenant_0
TENANT_DB_USER=user_tenant_0
TENANT_DB_PASS=replace_me

# DATABASE_URL is what Prisma reads. The host `global-postgres` resolves
# inside the reverse-proxy-network.
DATABASE_URL=postgresql://user_tenant_0:replace_me@global-postgres:5432/db_tenant_0?schema=public

# --- Outbound mail via Mailcow ----------------------------------------------
SMTP_HOST=mail.unkredible.com
SMTP_PORT=587
SMTP_USER=example@unkredible.com
SMTP_PASS=replace_me
SMTP_FROM_NAME=Example

# --- Stripe (shared keys, per-tenant attribution via metadata) ---------------
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Optional default price id for the tenant's main subscription.
STRIPE_PRICE_ID=

# --- Auth.js (NextAuth) ------------------------------------------------------
# AUTH_SECRET is generated per tenant by setup-tenant.sh (openssl rand).
AUTH_SECRET=replace_me
# Canonical external URL of this tenant; used to build OAuth callback URLs.
AUTH_URL=https://example.unkredible.com
# Required because the app runs behind nginx-proxy.
AUTH_TRUST_HOST=true
# From: address for magic-link emails (defaults to SMTP_USER).
EMAIL_FROM=example@unkredible.com
# Google OAuth (optional; magic-link email works without it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- biggym platform ---------------------------------------------------------
# Comma-separated emails that get the super_admin role (platform owner).
# These users see /admin (gyms overview + per-client rate + run billing).
SUPERADMIN_EMAILS=
# Shared token so a monthly cron can POST /api/admin/bill without a session.
# Send it as header  x-cron-token: <value>.  Generate: openssl rand -hex 24
BILLING_CRON_TOKEN=

# --- Site gate (optional) ----------------------------------------------------
# Set a password to hide the whole site behind a single shared password
# (a pre-curtain for curious visitors, separate from per-user login).
# Leave empty to disable. /api/* (webhooks, OAuth callbacks) is never gated.
SITE_GATE_PASSWORD=

# --- Let's Encrypt -----------------------------------------------------------
LETSENCRYPT_EMAIL=admin@unkredible.com

# --- Storage (filesystem) ----------------------------------------------------
# Where the container looks for the storage directory. Bind-mounted from
# /var/www/apps/tenant_<id>_<name>/storage on the VM.
STORAGE_DIR=/app/storage

# --- Optional: HTTPS unsubscribe endpoint ------------------------------------
# When set, outbound mail adds RFC 8058 one-click List-Unsubscribe.
# UNSUBSCRIBE_URL=https://example.unkredible.com/unsubscribe

# --- Optional: pin a specific tenant image tag -------------------------------
# Defaults to unkredible/tenant-app:latest if unset.
TENANT_IMAGE=unkredible/tenant-app:latest

# --- Next.js runtime ---------------------------------------------------------
NODE_ENV=production
