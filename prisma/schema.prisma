// =============================================================================
// biggym — gym-management SaaS schema.
//
// One deployment serves many gyms. Each gym is a "Gym" row (the internal
// tenant). Tenant isolation is enforced in application code: every query is
// scoped by gymId derived from the signed-in user's Membership. (The whole
// biggym deployment already has its own isolated Postgres database provided by
// the unkredible platform; this internal tenant layer separates gyms inside it.)
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) — magic-link + Google + email/password (Credentials).
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  // Set only for email/password (Credentials) logins. scrypt hash.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  client      Client?

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Tenancy: gyms + staff/client memberships.
// ---------------------------------------------------------------------------

enum GymStatus {
  trial
  active
  suspended
}

enum MemberRole {
  super_admin // platform owner (you)
  gym_admin
  reception
  trainer
  client
}

model Gym {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  status       GymStatus @default(trial)
  contactEmail String?
  appName      String?
  // Visual theme: one of the 5 presets + light/dark mode + optional logo.
  theme        String    @default("emerald") // emerald | crimson | ocean | sunset | violet
  themeMode    String    @default("dark")    // light | dark
  primaryColor String    @default("#11221f") // legacy, kept for compatibility
  accentColor  String    @default("#f6c65b")
  logoUrl      String?
  bannerUrl    String?

  // Per-gym override of the per-activated-client rate (cents). Null = use the
  // platform default in PlatformConfig.
  clientUnitPriceCents Int?

  // Stripe (subscription bought from the portal).
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  plan                 String?
  subscriptionStatus   String  @default("none")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  clients      Client[]
  exercises    ExerciseLibrary[]
  programs     WorkoutProgram[]
  invites      ClientInvite[]
  staffInvites StaffInvite[]
  activations  BillableActivation[]
  locations    GymLocation[]
  documents    ClientDocument[]
  events       Event[]
  plans        Plan[]

  @@index([slug])
}

enum Recurrence {
  none
  daily
  weekly
  monthly
}

enum EventAudience {
  all // every client
  plan // only clients on a specific plan
}

// A subscription/membership plan a gym offers. Clients are assigned one; events
// can be restricted to a plan's holders.
model Plan {
  id         String   @id @default(cuid())
  gymId      String
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name       String
  priceCents Int?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  clients Client[]
  events  Event[] @relation("EventPlans")

  @@index([gymId])
}

model Event {
  id         String        @id @default(cuid())
  gymId      String
  gym        Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  title      String
  notes      String?
  startsAt   DateTime
  endsAt     DateTime?
  allDay     Boolean       @default(false)
  recurrence Recurrence    @default(none)
  recurUntil DateTime?
  // Where it happens: an existing gym location, or a one-off free-text place.
  locationId String?
  location   GymLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationText String?
  // Max participants (null = unlimited).
  capacity   Int?
  // Who it is for: all clients, or holders of any of the linked plans.
  audience   EventAudience @default(all)
  plans      Plan[]        @relation("EventPlans")
  // The trainer running it (sees + exports the roster).
  trainerId  String?
  trainer    Membership?   @relation("EventTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  exceptions EventException[]
  bookings   EventBooking[]

  @@index([gymId, startsAt])
}

// A client's signup for one occurrence of an event. occurrenceDate is the
// occurrence's base scheduled start (matches EventException.originalDate).
model EventBooking {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime
  createdAt      DateTime @default(now())

  @@unique([eventId, occurrenceDate, clientId])
  @@index([eventId, occurrenceDate])
  @@index([clientId])
}

// Per-occurrence override of a recurring Event: cancel one date or change its
// details without touching the rest of the series. Matched by originalDate.
model EventException {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originalDate DateTime // the occurrence's scheduled start being overridden
  canceled     Boolean   @default(false)
  title        String?
  notes        String?
  startsAt     DateTime?
  endsAt       DateTime?
  locationId   String?
  locationText String?
  capacity     Int?
  createdAt    DateTime  @default(now())

  @@unique([eventId, originalDate])
  @@index([eventId])
}

model ClientDocument {
  id          String   @id @default(cuid())
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  contentType String
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@index([gymId])
}

model GymLocation {
  id          String   @id @default(cuid())
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name        String
  addressLine String
  city        String?
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  events Event[]

  @@index([gymId])
}

model Membership {
  id        String     @id @default(cuid())
  gymId     String
  gym       Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole
  fullName  String
  email     String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  assignedClients Client[]         @relation("TrainerClients")
  programs        WorkoutProgram[]
  events          ClientEvent[]
  eventsLed       Event[]          @relation("EventTrainer")

  // One membership per user per gym; a user can belong to many gyms.
  @@unique([userId, gymId])
  @@index([gymId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Clients + workout domain (ported from gym-manager).
// ---------------------------------------------------------------------------

enum ClientStatus {
  lead
  consents
  anamnesis
  assigned
  active
}

model Client {
  id                String       @id @default(cuid())
  gymId             String
  gym               Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId            String?      @unique
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName          String
  email             String?
  phone             String?
  birthDate         DateTime?
  fiscalCode        String?
  addressLine       String?
  city              String?
  emergencyName     String?
  emergencyPhone    String?
  onboardingStatus  ClientStatus @default(lead)
  activatedAt       DateTime?
  assignedTrainerId String?
  assignedTrainer   Membership?  @relation("TrainerClients", fields: [assignedTrainerId], references: [id], onDelete: SetNull)
  planId            String?
  plan              Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)

  subscriptionPlan   String?
  subscriptionStatus String    @default("none")
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?

  termsConsentAt     DateTime?
  healthConsentAt    DateTime?
  marketingConsentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs    WorkoutProgram[]
  events      ClientEvent[]
  logs        WorkoutLog[]
  activations BillableActivation[]
  documents   ClientDocument[]
  bookings    EventBooking[]

  @@index([gymId])
  @@index([gymId, onboardingStatus])
}

model ExerciseLibrary {
  id           String   @id @default(cuid())
  gymId        String?
  gym          Gym?     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name         String
  muscleGroup  String
  equipment    String?
  instructions String?
  videoUrl     String?
  createdAt    DateTime @default(now())

  @@index([gymId])
}

enum ProgramStatus {
  draft
  active
  archived
}

model WorkoutProgram {
  id        String         @id @default(cuid())
  gymId     String
  gym       Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainerId String?
  trainer   Membership?    @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  title     String
  goal      String?
  status    ProgramStatus  @default(draft)
  startsOn  DateTime?
  endsOn    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  days WorkoutDay[]

  @@index([gymId, clientId])
}

model WorkoutDay {
  id        String         @id @default(cuid())
  programId String
  program   WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  title     String
  dayOrder  Int            @default(1)
  notes     String?

  exercises WorkoutExercise[]
}

model WorkoutExercise {
  id            String     @id @default(cuid())
  workoutDayId  String
  workoutDay    WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exerciseName  String
  exerciseOrder Int        @default(1)
  targetSets    Int        @default(3)
  targetReps    String     @default("8-10")
  targetLoad    String?
  rpeTarget     Float?
  restSeconds   Int?
  notes         String?
}

model WorkoutLog {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  performedAt DateTime @default(now())
  loadKg      Float?
  reps        Int?
  rpe         Float?
  note        String?
  createdAt   DateTime @default(now())

  @@index([clientId, performedAt])
}

model ClientEvent {
  id        String      @id @default(cuid())
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String?
  author    Membership? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  eventType String      @default("note")
  body      String
  createdAt DateTime    @default(now())

  @@index([clientId, createdAt])
}

model StripeEvent {
  id          String   @id // Stripe event id (evt_…)
  type        String
  processedAt DateTime @default(now())

  @@index([type])
}

// ---------------------------------------------------------------------------
// Billing: platform charges each gym per ACTIVATED client, aggregated into one
// Stripe invoice per month (never per-client micro-charges).
// ---------------------------------------------------------------------------

// Single-row platform configuration (id = "singleton").
model PlatformConfig {
  id                   String   @id @default("singleton")
  clientUnitPriceCents Int      @default(50) // €0.50 per activated client
  currency             String   @default("eur")
  updatedAt            DateTime @updatedAt
}

// Pending email invitation for a staff member to join a gym with a role.
model StaffInvite {
  id         String     @id @default(cuid())
  gymId      String
  gym        Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  email      String
  role       MemberRole
  fullName   String?
  token      String     @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([gymId])
  @@index([token])
}

// Pending email invitation for a client to confirm enrolment.
model ClientInvite {
  id         String    @id @default(cuid())
  gymId      String
  gym        Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  email      String
  fullName   String?
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  clientId   String?
  createdAt  DateTime  @default(now())

  @@index([gymId])
  @@index([token])
}

// One row per client activation = one billable unit. Aggregated monthly.
model BillableActivation {
  id                  String    @id @default(cuid())
  gymId               String
  gym                 Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  unitPriceCents      Int // rate snapshot at activation time
  currency            String    @default("eur")
  periodMonth         String // "YYYY-MM" the activation belongs to
  billedAt            DateTime?
  stripeInvoiceItemId String?
  createdAt           DateTime  @default(now())

  @@unique([clientId]) // a client is billed once
  @@index([gymId, periodMonth])
  @@index([billedAt])
}
